{
  "name": "spotify-visualizer",
  "version": "1.0.0",
  "description": "Multi-Template Viral Music Visualizer Generator using Puppeteer, Sharp and FFmpeg",
  "main": "generate.js",
  "type": "module",
  "scripts": {
    "start": "node generate.js",
    "ui": "node server.js",
    "preview": "node generate.js --preview-all",
    "batch": "node generate.js --count 70 --concurrency 20"
  },
  "dependencies": {
    "puppeteer": "^22.0.0",
    "sharp": "^0.35.4"
  }
}
